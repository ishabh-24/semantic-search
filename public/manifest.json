{
  "manifest_version": 3,
  "name": "Drive Semantic Search",
  "version": "0.1.0",
  "description": "Meaning-based search over your Google Docs. Local-first: your content never touches a third-party server.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["alarms", "identity", "identity.email"],
  "host_permissions": ["https://oauth2.googleapis.com/", "https://www.googleapis.com/"],
  "oauth2": {
    "client_id": "1094726331622-omcocdgeb3apg6l2c6iast7607k3imhh.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.readonly",
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Drive Semantic Search",
    "default_popup": "popup.html"
  }
}
