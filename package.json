{
  "name": "drive-semantic-search",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first hybrid semantic search over Google Docs — a Manifest V3 Chrome extension",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "esbuild eval/run-eval.ts --bundle --platform=node --format=esm --packages=external --outfile=eval/.build/run-eval.mjs && node eval/.build/run-eval.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.328",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "minisearch": "^7.2.0"
  }
}
